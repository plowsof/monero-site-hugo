{
  "name": "monero-site",
  "private": true,
  "type": "module",
  "description": "Tooling only: the site itself is built with Hugo (see README.md).",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "htmlhint 'dist/**/*.html'"
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "lefthook": "^2.2.2",
    "prettier": "3.9.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
